# Treat all files as text by default (LF line endings)
* text=auto

# Binary file types — never apply line ending conversion
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.ico binary
*.webp binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.mp4 binary
*.mp3 binary
*.zip binary
*.pdf binary
